{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ml",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "cd ml; Remove-Item Env:RSW_RAG_URL -ErrorAction SilentlyContinue; $env:RSW_STATE_DIR='state/d8-demo1029'; uvicorn main:app --port 8000"],
      "port": 8000
    },
    {
      "name": "api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "cd api; $env:FIELD_MEMORY='1'; $env:API_DB='state/d8-demo1029.db'; ..\\.venv\\Scripts\\python.exe -m uvicorn main:app --port 9000"],
      "port": 9000
    },
    {
      "name": "ui",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "cd ui; npm run dev -- --port 5173 --strictPort"],
      "port": 5173
    }
  ]
}
