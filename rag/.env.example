NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=your_actual_database_name

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Enable only when corporate/OS certificates are needed. Verification remains on.
RAG_SYSTEM_TRUST=0
# Relative to rag/; generated files and backups are ignored by Git.
RAG_RUNTIME_DIR=var