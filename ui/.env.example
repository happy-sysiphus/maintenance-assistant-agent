# 이 파일을 복사해 .env.local 을 만들어 쓴다. 실제 .env 파일은 커밋하지 않는다.

# true: MSW가 src/mocks/의 고정 JSON으로 응답 / false: 진짜 api 서버로 요청
VITE_USE_MOCK=true

# 화면 코드가 요청을 보내는 주소의 앞부분
VITE_API_BASE_URL=/api

# VITE_USE_MOCK=false일 때 개발 서버가 /api 요청을 넘길 api 서버 주소 (예시 값, 포트는 api 담당과 정할 것)
VITE_API_PROXY_TARGET=http://localhost:9000
